* {
    bg:       #1e1e2e;
    bg-alt:   #313244;
    fg:       #cdd6f4;
    fg-dim:   #6c7086;
    accent:   #cba6f7;
    urgent:   #f38ba8;

    background-color: transparent;
    text-color:       @fg;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    border-radius:    8px;
    width:            240px;
    padding:          10px;
}

mainbox {
    background-color: transparent;
    children:         [ listview ];
    spacing:          0;
}

listview {
    background-color: transparent;
    lines:            5;
    columns:          1;
    spacing:          4px;
    scrollbar:        false;
    dynamic:          false;
}

element {
    background-color: transparent;
    border-radius:    6px;
    padding:          9px 12px;
    spacing:          10px;
}

element selected {
    background-color: @accent;
    text-color:       @bg;
}

element-icon {
    size:             16px;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    vertical-align:   0.5;
}
